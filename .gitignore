# Virtual environment
.venv/

# PyInstaller build artifacts
build/
dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Test artifacts
.pytest_cache/

# Measurement output — data belongs in a data store, not in git
*.dwc
*.npz
data/
# …except the simulator baselines, which are test fixtures rather than
# measurements: tests/test_golden_sim.py regenerates them and asserts they come
# back bit-identical, which is what proves a refactor of the simulation physics
# or the scan loop changed nothing.
!tests/golden/*.npz

# Runtime preferences, written next to the program (see SETTINGS_PATH)
settings.json
settings.json.tmp

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
